# Variables de entorno del cliente.
# Solo las que empiezan con VITE_ quedan expuestas al bundle del cliente.
# Copiá este archivo a .env y completá los valores.

# VITE_API_URL=

# Token de cuenta de Supabase con acceso al proyecto (Management API).
# Sin prefijo VITE_ a propósito: no es del cliente, es para scripts/sql.sh.
# SUPABASE_ACCESS_TOKEN_GG2=
